---
import Base from "../../layouts/Base.astro";

const title = "Fence Calculator – Posts, Panels, Rails, Pickets, Gates, Concrete & Cost";
const description =
  "Estimate fence posts, panels, rails, pickets, gates, concrete, spacing and cost for wood, vinyl, privacy and chain-link fences.";
const canonical = "https://easycalc.io/fence-calculator/";

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      name: "Fence Calculator",
      applicationCategory: "UtilitiesApplication",
      operatingSystem: "Any",
      offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "USD",
      },
      url: canonical,
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What is a typical fence post spacing?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Most wood privacy fences use 8 ft spacing. 6 ft is used for heavier loads or high wind areas. 10 ft is sometimes used with lighter materials or additional bracing.",
          },
        },
        {
          "@type": "Question",
          name: "How many posts do I need for 100 ft of fence?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "At 8 ft spacing, 100 ft requires approximately 13 posts (sections + 1). Exact count depends on gates, corners, and chosen spacing.",
          },
        },
        {
          "@type": "Question",
          name: "How much does 100 ft of fence cost?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Cost varies widely by material, region, and labor. Material-only estimates range from roughly <span class='todo'>待填：价格区间</span> depending on wood, vinyl, or chain link. Always check local supplier pricing.",
          },
        },
        {
          "@type": "Question",
          name: "How deep should fence posts be buried?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "A common rule is to bury one-third of the post length. In frost-prone areas the bottom of the post should extend below the local frost line. Check local building codes for exact requirements.",
          },
        },
        {
          "@type": "Question",
          name: "Do I need a permit for a fence?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Requirements vary by city and HOA. Many areas require permits for fences above a certain height or near property lines. Contact your local building department and call 811 before digging.",
