<script>
  // CONFIG: all coefficients in one place. Verify each value.
  const CONFIG = {
    // Post spacing options already in the form
    railsPerSection: {
      "wood-privacy": 3,   // TODO: confirm common rail count
      "wood-picket": 2,
      "chain-link": 1,     // top rail; bottom tension separate
      "vinyl": 2,
      "aluminum": 2,
      "wrought-iron": 2,
    },
    picketWidthFt: 0.5,    // TODO: verify typical picket width
    picketGapFt: 0.125,    // TODO: verify typical gap
    concreteBagsPerPost60lb: 1, // TODO: verify against hole volume
    // Cost per linear foot placeholders — TODO replace
    costPerFt: {
      "wood-privacy": 25,
      "wood-picket": 20,
      "chain-link": 15,
      "vinyl": 30,
      "aluminum": 35,
      "wrought-iron": 40,
    },
  };

  const form = document.getElementById("fence-form");
  const results = document.getElementById("results");

  form?.addEventListener("submit", (e) => {
    e.preventDefault();

    const lengths = Array.from(document.querySelectorAll(".seg-length"))
      .map((el) => parseFloat(el.value) || 0)
      .filter((n) => n > 0);

    const totalLength = lengths.reduce((a, b) => a + b, 0);
    if (totalLength <= 0) return;

    const spacing = parseFloat(document.getElementById("spacing").value);
    const material = document.getElementById("material").value;
    const gates = parseInt(document.getElementById("gates").value, 10) || 0;
    const waste = parseFloat(document.getElementById("waste").value);
    const metric = document.getElementById("metric").checked;

    const sections = Math.ceil(totalLength / spacing);
    const posts = sections + 1 + gates; // simplified extra for gates
    const railsPer = CONFIG.railsPerSection[material] || 2;
    const rails = (sections - gates) * railsPer;
    const pickets = Math.ceil((totalLength - gates * 4) / (CONFIG.picketWidthFt + CONFIG.picketGapFt));

    const netPosts = posts;
    const netRails = rails;
    const netPickets = pickets;
    const netHardware = gates;

    const wastePosts = Math.ceil(netPosts * (1 + waste));
    const wasteRails = Math.ceil(netRails * (1 + waste));
    const wastePickets = Math.ceil(netPickets * (1 + waste));

    const buyPosts = wastePosts;
    const buyRails = wasteRails;
    const buyPickets = wastePickets;
    const buyConcrete = Math.ceil(posts * CONFIG.concreteBagsPerPost60lb);
    const buyFasteners = Math.ceil(rails / 10); // placeholder

    document.getElementById("net-posts").textContent = netPosts;
    document.getElementById("net-rails").textContent = netRails;
    document.getElementById("net-pickets").textContent = netPickets;
    document.getElementById("net-hardware").textContent = netHardware;

    document.getElementById("waste-posts").textContent = wastePosts;
    document.getElementById("waste-rails").textContent = wasteRails;
    document.getElementById("waste-pickets").textContent = wastePickets;

    document.getElementById("buy-posts").textContent = buyPosts;
    document.getElementById("buy-rails").textContent = buyRails;
    document.getElementById("buy-pickets").textContent = buyPickets;
    document.getElementById("buy-concrete").textContent = buyConcrete;
    document.getElementById("buy-fasteners").textContent = buyFasteners;

    results.hidden = false;
  });

  document.getElementById("copy-btn")?.addEventListener("click", () => {
    const text = results.innerText;
    navigator.clipboard.writeText(text).catch(() => {});
  });
</script>
