---
import Base from "../../layouts/Base.astro";

const title = "Fence Calculator – Posts, Panels, Rails, Pickets, Gates, Concrete & Cost";
const description =
  "Estimate fence posts, panels, rails, pickets, gates, concrete, spacing and cost for wood, vinyl, privacy and chain-link fences.";
const canonical = "https://easycalc.io/fence-calculator/";

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      name: "Fence Calculator",
      applicationCategory: "UtilitiesApplication",
      operatingSystem: "Any",
      offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "USD",
      },
      url: canonical,
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "What is a typical fence post spacing?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Most wood privacy fences use 8 ft spacing. 6 ft is used for heavier loads or high wind areas. 10 ft is sometimes used with lighter materials or additional bracing.",
          },
        },
        {
          "@type": "Question",
          name: "How many posts do I need for 100 ft of fence?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "At 8 ft spacing, 100 ft requires approximately 14 posts (sections + 1). Exact count depends on gates, corners, and chosen spacing.",
          },
        },
        {
          "@type": "Question",
          name: "How much does 100 ft of fence cost?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Cost varies widely by material, region, and labor. Material-only estimates range depending on wood, vinyl, or chain link. Always check local supplier pricing.",
          },
        },
        {
          "@type": "Question",
          name: "How deep should fence posts be buried?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "A common rule is to bury one-third of the post length. In frost-prone areas the bottom of the post should extend below the local frost line. Check local building codes for exact requirements.",
          },
        },
        {
          "@type": "Question",
          name: "Do I need a permit for a fence?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Requirements vary by city and HOA. Many areas require permits for fences above a certain height or near property lines. Contact your local building department and call 811 before digging.",
          },
        },
        {
          "@type": "Question",
          name: "Which fence material lasts the longest?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Vinyl and aluminum generally require less maintenance and last longer than untreated wood. Treated wood and chain link have intermediate lifespans. Actual longevity depends on climate, installation quality, and maintenance.",
          },
        },
      ],
    },
  ],
};
---

<Base title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <!-- SEO: breadcrumb -->
  <nav aria-label="Breadcrumb">
    <ol>
      <li><a href="/">Home</a></li>
      <li>Fence Calculator</li>
    </ol>
  </nav>

  <!-- SEO: single H1 -->
  <h1>Fence Calculator for Posts, Panels, Spacing & Cost</h1>

  <!-- Full calculator: labels are static HTML -->
  <section class="calculator" id="fence-calc">
    <h2>Fence Calculator</h2>
    <p>Enter dimensions for an estimate of posts, rails, pickets or panels, concrete, and cost. Supports up to 5 segments for irregular layouts.</p>

    <form id="fence-form">
      <div>
        <label>Segment 1 length
          <input type="text" class="seg-length" placeholder="e.g. 100 ft 6 in" value="100" />
        </label>
      </div>
      <div>
        <label>Segment 2 (optional)
          <input type="text" class="seg-length" placeholder="0" value="0" />
        </label>
      </div>
      <div>
        <label>Segment 3 (optional)
          <input type="text" class="seg-length" placeholder="0" value="0" />
        </label>
      </div>
      <div>
        <label>Segment 4 (optional)
          <input type="text" class="seg-length" placeholder="0" value="0" />
        </label>
      </div>
      <div>
        <label>Segment 5 (optional)
          <input type="text" class="seg-length" placeholder="0" value="0" />
        </label>
      </div>
      <p id="length-error" class="note" style="color:#b91c1c;display:none;margin-top:0.25rem;"></p>

      <label>Height
        <select id="height">
          <option value="3">3 ft</option>
          <option value="4">4 ft</option>
          <option value="5">5 ft</option>
          <option value="6" selected>6 ft</option>
          <option value="8">8 ft</option>
        </select>
      </label>

      <label>Material
        <select id="material">
          <option value="wood-privacy">Wood Privacy</option>
          <option value="wood-picket">Wood Picket</option>
          <option value="chain-link">Chain Link</option>
          <option value="vinyl">Vinyl</option>
          <option value="aluminum">Aluminum</option>
          <option value="wrought-iron">Wrought Iron</option>
        </select>
      </label>

      <label>Post spacing
        <select id="spacing">
          <option value="6">6 ft</option>
          <option value="8" selected>8 ft</option>
          <option value="10">10 ft</option>
        </select>
      </label>

      <label>Number of gates
        <input type="number" id="gates" min="0" value="0" />
      </label>

      <label>Gate width (ft)
        <input type="number" id="gate-width" min="3" step="0.5" value="4" />
      </label>

      <label>Corners
        <input type="number" id="corners" min="0" value="0" />
      </label>

      <label>Waste factor
        <select id="waste">
          <option value="0.05">5%</option>
          <option value="0.10" selected>10%</option>
          <option value="0.15">15%</option>
        </select>
      </label>

      <button type="submit">Calculate</button>
    </form>

    <div id="results" class="results" hidden>
      <h3>Net quantities</h3>
      <ul>
        <li>Posts: <span id="net-posts">—</span></li>
        <li>Rails: <span id="net-rails">—</span></li>
        <li>Pickets / panels: <span id="net-pickets">—</span></li>
        <li>Gate hardware sets: <span id="net-hardware">—</span></li>
      </ul>

      <h3>With waste</h3>
      <ul>
        <li>Posts: <span id="waste-posts">—</span></li>
        <li>Rails: <span id="waste-rails">—</span></li>
        <li>Pickets / panels: <span id="waste-pickets">—</span></li>
      </ul>

      <h3>Shopping list (rounded)</h3>
      <ul>
        <li>Posts to buy: <span id="buy-posts">—</span></li>
        <li>Rails to buy: <span id="buy-rails">—</span></li>
        <li>Pickets / panels to buy: <span id="buy-pickets">—</span></li>
        <li>Concrete 60 lb bags: <span id="buy-concrete-60">—</span></li>
        <li>Concrete 80 lb bags: <span id="buy-concrete-80">—</span></li>
        <li>Screws / fasteners: <span id="buy-fasteners">—</span></li>
      </ul>

      <h3>Estimated cost range</h3>
      <p id="cost-range">—</p>

      <button type="button" id="copy-btn">Copy list as text</button>
      <p class="note">Estimates only. Example pricing — replace unit prices in the configuration. Includes materials and basic labor. Verify all quantities and prices with local suppliers. Concrete uses hole-volume method.</p>
    </div>
  </section>

  <!-- SEO: explanatory content — all static HTML -->
  <section>
    <h2>How to Calculate Fence Materials</h2>
    <h3>1. Calculate posts</h3>
    <p>Divide total length by post spacing and round up to get the number of sections. Posts equal sections plus one, plus any extra posts required at corners or gates.</p>
    <h3>2. Calculate rails</h3>
    <p>Most wood and metal fences use two or three horizontal rails per section. Chain-link fences typically use a top rail plus bottom tension wire. Vinyl privacy fences commonly use two rails per section.</p>
    <h3>3. Calculate pickets or panels</h3>
    <p>For picket fences, divide the length of each section by (picket width + gap). Privacy and vinyl fences are often sold as full panels sized to the chosen spacing.</p>
    <h3>4. Calculate concrete</h3>
    <p>Each post sits in a hole. Hole diameter is roughly three times the post width. Hole depth is about one-third of the above-ground height plus 6 inches. Concrete volume equals hole volume minus the volume of the embedded post. Results are shown for both 60 lb and 80 lb bags.</p>
  </section>

  <section>
    <h2>Fence Post Spacing and Depth</h2>
    <p>6 ft spacing is used where wind loads are high or the fence is tall. 8 ft is the most common spacing for residential wood privacy fences. 10 ft spacing can be used with lighter materials if the posts and rails are strong enough. A frequent rule of thumb is to bury one-third of the post length. In areas with frost, the bottom of the post should extend below the local frost line. Local building departments publish the exact frost depth and any required embedment.</p>
  </section>

