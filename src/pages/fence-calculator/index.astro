<script>
  // CONFIG: all tunable coefficients and example prices.
  // 示例单价，请替换 — replace with verified local averages.
  const CONFIG = {
    // Height multipliers (base = 6 ft)
    heightCostFactor: { 3: 0.65, 4: 0.8, 5: 0.9, 6: 1.0, 8: 1.35 },
    heightConcreteFactor: { 3: 0.7, 4: 0.85, 5: 0.95, 6: 1.0, 8: 1.4 },
    // Concrete hole geometry (4x4 post assumed)
    postWidthFt: 4 / 12,
    holeDiameterMultiplier: 3,
    holeDepthExtraFt: 0.5,
    bag60CuFt: 0.45,
    bag80CuFt: 0.6,
    // Rails per section by material
    railsPerSection: {
      "wood-privacy": 3,
      "wood-picket": 2,
      "chain-link": 1,
      "vinyl": 2,
      "aluminum": 2,
      "wrought-iron": 2,
    },
    // Example cost per linear foot (materials + basic labor) — 示例单价，请替换
    costPerFtMin: {
      "wood-privacy": 18,
      "wood-picket": 15,
      "chain-link": 12,
      "vinyl": 22,
      "aluminum": 25,
      "wrought-iron": 30,
    },
    costPerFtMax: {
      "wood-privacy": 32,
      "wood-picket": 28,
      "chain-link": 22,
      "vinyl": 40,
      "aluminum": 45,
      "wrought-iron": 55,
    },
    gateCostEach: 180,
  };

  const form = document.getElementById("fence-form");
  const results = document.getElementById("results");
  const lengthError = document.getElementById("length-error");
  const currency = new Intl.NumberFormat("en-US", { style: "currency", currency: "USD", maximumFractionDigits: 0 });

  function parseLength(raw) {
    if (!raw || typeof raw !== "string") return NaN;
    const s = raw.trim().toLowerCase();
    if (s === "" || s === "0") return 0;
    const ftMatch = s.match(/(\d+(?:\.\d+)?)\s*(?:ft|')?/);
    const inMatch = s.match(/(\d+(?:\.\d+)?)\s*(?:in|")/);
    let feet = 0;
    if (ftMatch) feet += parseFloat(ftMatch[1]);
    if (inMatch) feet += parseFloat(inMatch[1]) / 12;
    if (!ftMatch && !inMatch) {
      const plain = parseFloat(s);
      if (!isNaN(plain)) feet = plain;
    }
    return isNaN(feet) ? NaN : feet;
  }

  function showError(msg) {
    lengthError.textContent = msg;
    lengthError.style.display = "block";
    results.hidden = true;
  }

  function clearError() {
    lengthError.style.display = "none";
    lengthError.textContent = "";
  }

  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    clearError();

    const lengthInputs = Array.from(document.querySelectorAll(".seg-length"));
    const lengths = lengthInputs.map((el) => parseLength(el.value));
    const totalLength = lengths.reduce((sum, n) => sum + (isNaN(n) ? 0 : Math.max(0, n)), 0);

    if (lengths.every((n) => isNaN(n) || n === 0)) {
      showError("Please enter a valid length in at least one segment (e.g. 100 or 100 ft 6 in).");
      return;
    }
    if (totalLength <= 0) {
      showError("Total length must be greater than 0.");
      return;
    }
    if (totalLength > 10000) {
      showError("Total length cannot exceed 10,000 ft.");
      return;
    }

    const height = parseInt(document.getElementById("height").value, 10);
    const material = document.getElementById("material").value;
    const spacing = parseFloat(document.getElementById("spacing").value);
    const gates = Math.max(0, parseInt(document.getElementById("gates").value, 10) || 0);
    const gateWidth = Math.max(0, parseFloat(document.getElementById("gate-width").value) || 4);
    const corners = Math.max(0, parseInt(document.getElementById("corners").value, 10) || 0);
    const waste = parseFloat(document.getElementById("waste").value);

    // Core logic (consistent with homepage verified results)
    const effectiveLength = Math.max(0, totalLength - gates * gateWidth);
    const sections = Math.ceil(effectiveLength / spacing);
    const basePosts = sections + 1;
    const posts = basePosts + corners + gates * 2;
    const railsPer = CONFIG.railsPerSection[material] || 2;
    const rails = Math.max(0, (sections - gates) * railsPer);
    const pickets = Math.max(0, sections - gates); // panels / sections after gates

    const netPosts = posts;
    const netRails = rails;
    const netPickets = pickets;
    const netHardware = gates;

    const wastePosts = Math.ceil(netPosts * (1 + waste));
    const wasteRails = Math.ceil(netRails * (1 + waste));
    const wastePickets = Math.ceil(netPickets * (1 + waste));

    // Concrete by volume + height factor
    const holeDiameterFt = CONFIG.postWidthFt * CONFIG.holeDiameterMultiplier;
    const holeRadiusFt = holeDiameterFt / 2;
    const holeDepthFt = (height / 3) + CONFIG.holeDepthExtraFt;
    const holeVolume = Math.PI * holeRadiusFt * holeRadiusFt * holeDepthFt;
    const postEmbedVolume = CONFIG.postWidthFt * CONFIG.postWidthFt * holeDepthFt;
    let concreteVolPerPost = Math.max(0, holeVolume - postEmbedVolume);
    concreteVolPerPost *= CONFIG.heightConcreteFactor[height] || 1;
    const bags60PerPost = Math.ceil(concreteVolPerPost / CONFIG.bag60CuFt);
    const bags80PerPost = Math.ceil(concreteVolPerPost / CONFIG.bag80CuFt);
    const total60 = bags60PerPost * posts;
    const total80 = bags80PerPost * posts;

    // Cost range
    const factor = CONFIG.heightCostFactor[height] || 1;
    const minPerFt = (CONFIG.costPerFtMin[material] || 20) * factor;
    const maxPerFt = (CONFIG.costPerFtMax[material] || 35) * factor;
    const minTotal = totalLength * minPerFt + gates * CONFIG.gateCostEach;
    const maxTotal = totalLength * maxPerFt + gates * CONFIG.gateCostEach;

    // Render
    document.getElementById("net-posts").textContent = netPosts;
    document.getElementById("net-rails").textContent = netRails;
    document.getElementById("net-pickets").textContent = netPickets;
    document.getElementById("net-hardware").textContent = netHardware;

    document.getElementById("waste-posts").textContent = wastePosts;
    document.getElementById("waste-rails").textContent = wasteRails;
    document.getElementById("waste-pickets").textContent = wastePickets;

    document.getElementById("buy-posts").textContent = wastePosts;
    document.getElementById("buy-rails").textContent = wasteRails;
    document.getElementById("buy-pickets").textContent = wastePickets;
    document.getElementById("buy-concrete-60").textContent = total60;
    document.getElementById("buy-concrete-80").textContent = total80;
    document.getElementById("buy-fasteners").textContent = Math.ceil(rails / 10);

    document.getElementById("cost-range").textContent =
      currency.format(minTotal) + " – " + currency.format(maxTotal);

    results.hidden = false;
  });

  document.getElementById("copy-btn")?.addEventListener("click", () => {
    const text = results.innerText;
    navigator.clipboard.writeText(text).catch(() => {});
  });

  /*
  Test notes (aligned with homepage):
  - 100 ft, 6 ft, wood-privacy, 0 corners, 0 gates, 8 ft spacing:
    sections = 13, posts = 14, panels = 13
    concrete per post falls in ~2.5–4 bags 60 lb range
  - Height 3 ft vs 8 ft produces different concrete and cost via factors
  - Invalid / zero / empty lengths show error and hide results
  - Corners and gates correctly adjust post and panel counts
  */
</script>
